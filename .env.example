# Kho corpus SQLite
DATABASE_PATH=data/esg.db
TOP_K=6
MAX_FILE_SIZE=78643200
MAX_PDF_PAGES=500

# LLM cục bộ / Ollama tương thích OpenAI. Giữ USE_LLM=false để chạy deterministic miễn phí.
USE_LLM=false
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TIMEOUT=3.0

# Truy xuất mặc định: BM25 có sẵn trong bộ cài đặt cơ bản
RETRIEVAL_MODE=bm25

# Truy xuất ngữ nghĩa là tùy chọn, cần cài: pip install -e ".[ml]"
# RETRIEVAL_MODE=hybrid
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RETRIEVAL_MODE=hybrid_rerank
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
